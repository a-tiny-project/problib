module

public import Problib.QuasiBorel.List
public import Problib.QuasiBorel.Measurable.Basic
public import Problib.Measure.Space.List

set_option autoImplicit false

/-!
# Generated quasi-Borel lists

This module proves that the generating functor preserves finite lists. For
every measurable random source, the quasi-Borel list of a generated space is
isomorphic to the space generated by the measurable list space. A measurable
list-valued map splits by its length into padded lists of each fixed length,
and an element type with no points has only the empty list.
-/

namespace Problib.QuasiBorel

open Problib.Measure (MeasurableMap)

public section

universe u v

variable {Ω : Type u} {α : Type v}

/-- Proves that every accepted random list of a generated space is measurable
into the measurable list space. -/
theorem ListRandom.measurable_ofMeasurable {source : Problib.Measure.Space Ω}
    {element : Problib.Measure.Space α}
    {random : Ω → List (Space.ofMeasurable source element).Carrier}
    (accepted : ListRandom (Space.ofMeasurable source element) random) :
    MeasurableMap source (Problib.Measure.Space.list element) random := by
  induction accepted with
  | nil => exact MeasurableMap.constant _ _ []
  | cons head _ induction =>
      exact MeasurableMap.comp (Problib.Measure.ListSpace.cons_measurable element)
        (Problib.Measure.Space.pair_measurable head induction)
  | reparam measurable _ induction => exact MeasurableMap.comp induction measurable
  | piecewise measurable _ induction => exact MeasurableMap.countable_piecewise measurable induction

/-- The first `length` entries of a list, padded with `point` past its end. -/
private def padded (point : α) : Nat → List α → List α
  | 0, _ => []
  | length + 1, values => values.headD point :: padded point length values.tail

private theorem padded_length (point : α) (values : List α) :
    padded point values.length values = values := by
  induction values with
  | nil => rfl
  | cons head tail induction =>
      show head :: padded point tail.length tail = head :: tail
      rw [induction]

private theorem headD_eq (point : α) (values : List α) :
    values.headD point =
      Sum.elim (fun _ : Unit => point) (fun value => value) (Problib.Measure.ListSpace.coordinate 0 values) := by
  cases values <;> rfl

/-- Padding a measurable random list to a fixed length gives an accepted random list. -/
private theorem padded_random {source : Problib.Measure.Space Ω}
    {element : Problib.Measure.Space α} (point : α) (length : Nat) :
    ∀ {random : Ω → List α}, MeasurableMap source (Problib.Measure.Space.list element) random →
      ListRandom (Space.ofMeasurable source element)
        (fun seed => padded point length (random seed)) := by
  induction length with
  | zero =>
      intro random _
      exact ListRandom.nil
  | succ length induction =>
      intro random measurable
      have headEqual : (fun seed => (random seed).headD point) = fun seed =>
          Sum.elim (fun _ : Unit => point) (fun value => value)
            (Problib.Measure.ListSpace.coordinate 0 (random seed)) :=
        funext fun seed => headD_eq point (random seed)
      have head : MeasurableMap source element (fun seed => (random seed).headD point) := by
        rw [headEqual]
        exact MeasurableMap.comp
          (MeasurableMap.sum_elim (MeasurableMap.constant _ _ point) (MeasurableMap.identity element))
          (MeasurableMap.comp (Problib.Measure.ListSpace.coordinate_measurable element 0) measurable)
      exact ListRandom.cons head
        (induction (MeasurableMap.comp (Problib.Measure.ListSpace.tail_measurable element) measurable))

/-- Proves that every measurable map into the measurable list space is an accepted
random list of the generated space. -/
theorem ListRandom.of_measurable {source : Problib.Measure.Space Ω}
    {element : Problib.Measure.Space α} {random : Ω → List α}
    (measurable : MeasurableMap source (Problib.Measure.Space.list element) random) :
    ListRandom (Space.ofMeasurable source element) random := by
  classical
  by_cases inhabited : Nonempty α
  · rcases inhabited with ⟨point⟩
    have equal : random = fun seed => padded point (random seed).length (random seed) :=
      funext fun seed => (padded_length point (random seed)).symm
    have glued : ListRandom (Space.ofMeasurable source element)
        (fun seed => padded point (random seed).length (random seed)) :=
      ListRandom.piecewise (element := Space.ofMeasurable source element) (partition := fun seed => (random seed).length)
        (branches := fun length seed => padded point length (random seed))
        (fun length => measurable (Problib.Measure.ListSpace.length_measurable element
          (Problib.Measure.Space.discrete_measurable (fun number => number = length))))
        (fun length => padded_random point length measurable)
    rw [equal]
    exact glued
  · have equal : random = fun _ => [] := by
      funext seed
      cases random seed with
      | nil => rfl
      | cons head _ => exact (inhabited ⟨head⟩).elim
    rw [equal]
    exact ListRandom.nil

/-- Canonical quasi-Borel morphism from the list of a generated space to the
space generated by the measurable list space. -/
@[expose] def Space.listToMeasurable (source : Problib.Measure.Space Ω)
    (element : Problib.Measure.Space α) :
    Hom (Space.list (Space.ofMeasurable source element))
      (Space.ofMeasurable source (Problib.Measure.Space.list element)) where
  toFun := fun values => values
  map_random := fun accepted => accepted.measurable_ofMeasurable

/-- Canonical quasi-Borel morphism from the space generated by the measurable
list space to the list of the generated space. -/
@[expose] def Space.listOfMeasurable (source : Problib.Measure.Space Ω)
    (element : Problib.Measure.Space α) :
    Hom (Space.ofMeasurable source (Problib.Measure.Space.list element))
      (Space.list (Space.ofMeasurable source element)) where
  toFun := fun values => values
  map_random := fun measurable => ListRandom.of_measurable measurable

theorem Space.listToMeasurable_listOfMeasurable (source : Problib.Measure.Space Ω)
    (element : Problib.Measure.Space α) :
    Hom.comp (Space.listToMeasurable source element) (Space.listOfMeasurable source element) =
      Hom.identity (Space.ofMeasurable source (Problib.Measure.Space.list element)) := by
  apply Hom.ext
  intro values
  rfl

theorem Space.listOfMeasurable_listToMeasurable (source : Problib.Measure.Space Ω)
    (element : Problib.Measure.Space α) :
    Hom.comp (Space.listOfMeasurable source element) (Space.listToMeasurable source element) =
      Hom.identity (Space.list (Space.ofMeasurable source element)) := by
  apply Hom.ext
  intro values
  rfl

end

end Problib.QuasiBorel
