module

public import Problib.QuasiBorel.CartesianClosed
public import Problib.QuasiBorel.Measurable.Pi

set_option autoImplicit false

/-!
# Exponentials out of countable keys

A measurable space of keys `ι` with an injection into `Nat` and measurable
points generates a countable quasi-Borel space; the discrete space is the
usual instance. The exponential out of that space is isomorphic to the
product `Π_ι Y` whenever random elements of `Y` survive selection by a
measurable `ι`-valued index. Every generated space has that property, and so
does every space over an inhabited source. For a generated `Y`, the exponential
is therefore isomorphic to the space generated by the measurable product.
-/

namespace Problib.QuasiBorel

open Problib.Measure (MeasurableMap)

public section

universe u v

variable {Ω : Type u} {ι : Type v} {β : Type v}

/-- A map out of an empty type is measurable. -/
private theorem measurable_of_empty {α : Type u} {γ : Type v} {domain : Problib.Measure.Space α}
    {codomain : Problib.Measure.Space γ} {function : α → γ} (empty : ¬Nonempty α) :
    MeasurableMap domain codomain function := by
  intro region _
  have equal : Problib.Measure.Set.preimage function region = Problib.Measure.Set.empty := by
    apply Problib.Measure.Set.ext
    intro value
    exact (empty ⟨value⟩).elim
  rw [equal]
  exact domain.empty

/-- Random elements of `codomain` survive selection by a measurable index into
`keys`: taking, at each seed, the branch the index names gives a random element. -/
@[expose] def Space.Selects (source : Problib.Measure.Space Ω) (keys : Problib.Measure.Space ι)
    (codomain : Space.{u, v} (Source.ofMeasurable source)) : Prop :=
  ∀ {index : Ω → ι}, MeasurableMap source keys index →
    ∀ (branches : ι → Ω → codomain.Carrier), (∀ point, codomain.Random (branches point)) →
      codomain.Random (fun seed => branches (index seed) seed)

/-- Selection by a countable index is countable gluing, given a fallback point
for the numbers the index type does not use. Each number's keys form a point
or nothing, so each piece of the source is measurable. -/
private theorem select_of_point {source : Problib.Measure.Space Ω}
    {keys : Problib.Measure.Space ι} {codomain : Space.{u, v} (Source.ofMeasurable source)}
    (countable : ∃ code : ι → Nat, Function.Injective code)
    (points : ∀ point, keys.Measurable (Problib.Measure.Set.singleton point)) (fallback : ι)
    {index : Ω → ι} (measurable : MeasurableMap source keys index)
    (branches : ι → Ω → codomain.Carrier) (accepted : ∀ point, codomain.Random (branches point)) :
    codomain.Random (fun seed => branches (index seed) seed) := by
  classical
  rcases countable with ⟨code, injective⟩
  let decode : Nat → ι := fun number =>
    if represented : ∃ point, code point = number then Classical.choose represented else fallback
  have decoded : ∀ point, decode (code point) = point := by
    intro point
    have represented : ∃ other, code other = code point := ⟨point, rfl⟩
    show (if found : ∃ other, code other = code point then Classical.choose found else fallback) =
      point
    split
    · rename_i found
      exact injective (Classical.choose_spec found)
    · rename_i missing
      exact (missing represented).elim
  have pieces : ∀ number, keys.Measurable (fun point => code point = number) := by
    intro number
    by_cases represented : ∃ point, code point = number
    · rcases represented with ⟨point, coded⟩
      have equal : (fun other => code other = number) = Problib.Measure.Set.singleton point := by
        apply Problib.Measure.Set.ext
        intro other
        exact ⟨fun same => injective (same.trans coded.symm), fun same => same ▸ coded⟩
      rw [equal]
      exact points point
    · have equal : (fun other => code other = number) = Problib.Measure.Set.empty := by
        apply Problib.Measure.Set.ext
        intro other
        exact ⟨fun same => (represented ⟨other, same⟩).elim, fun member => member.elim⟩
      rw [equal]
      exact keys.empty
  have glued : codomain.Random (fun seed => branches (decode (code (index seed))) seed) :=
    codomain.piecewise (partition := fun seed => code (index seed))
      (branches := fun number seed => branches (decode number) seed)
      (fun number => measurable (pieces number))
      (fun number => accepted (decode number))
  have equal : (fun seed => branches (index seed) seed) =
      fun seed => branches (decode (code (index seed))) seed := by
    funext seed
    rw [decoded]
  rw [equal]
  exact glued

/-- Over an inhabited source, every space selects by a countable index. -/
theorem Space.selects_of_nonempty {source : Problib.Measure.Space Ω}
    {keys : Problib.Measure.Space ι} (countable : ∃ code : ι → Nat, Function.Injective code)
    (points : ∀ point, keys.Measurable (Problib.Measure.Set.singleton point))
    (inhabited : Nonempty Ω) (codomain : Space.{u, v} (Source.ofMeasurable source)) :
    Space.Selects source keys codomain := by
  intro index measurable branches accepted
  rcases inhabited with ⟨seed⟩
  exact select_of_point countable points (index seed) measurable branches accepted

/-- Every generated space selects by a countable index. -/
theorem Space.selects_ofMeasurable {source : Problib.Measure.Space Ω}
    {keys : Problib.Measure.Space ι} (countable : ∃ code : ι → Nat, Function.Injective code)
    (points : ∀ point, keys.Measurable (Problib.Measure.Set.singleton point))
    (target : Problib.Measure.Space β) :
    Space.Selects source keys (Space.ofMeasurable source target) := by
  intro index measurable branches accepted
  classical
  by_cases inhabited : Nonempty ι
  · rcases inhabited with ⟨fallback⟩
    exact select_of_point countable points fallback measurable branches accepted
  · exact measurable_of_empty fun ⟨seed⟩ => inhabited ⟨index seed⟩

/-- Canonical quasi-Borel morphism reading a morphism out of a space of keys as
its family of values. -/
@[expose] def Space.exponentialToPi (source : Problib.Measure.Space Ω)
    (keys : Problib.Measure.Space ι)
    (codomain : Space.{u, v} (Source.ofMeasurable source)) :
    Hom (exponential (Space.ofMeasurable source keys) codomain)
      (pi fun _ : ι => codomain) where
  toFun := fun morphism point => morphism point
  map_random := by
    intro family accepted point
    exact accepted (randomPair := fun seed => (seed, point))
      ⟨MeasurableMap.identity source, MeasurableMap.constant _ _ point⟩

/-- Canonical quasi-Borel morphism reading a family of values as a morphism out of
a space of keys, for a codomain that selects by the key. -/
@[expose] def Space.piToExponential (source : Problib.Measure.Space Ω)
    (keys : Problib.Measure.Space ι)
    (codomain : Space.{u, v} (Source.ofMeasurable source))
    (selects : Space.Selects source keys codomain) :
    Hom (pi fun _ : ι => codomain)
      (exponential (Space.ofMeasurable source keys) codomain) where
  toFun := fun values => {
    toFun := values
    map_random := fun measurable =>
      selects measurable (fun point _ => values point) (fun point => codomain.constant (values point))
  }
  map_random := by
    intro family accepted randomPair pairAccepted
    exact selects pairAccepted.2 (fun point seed => family (randomPair seed).1 point)
      (fun point => codomain.reparam pairAccepted.1 (accepted point))

theorem Space.exponentialToPi_piToExponential (source : Problib.Measure.Space Ω)
    (keys : Problib.Measure.Space ι)
    (codomain : Space.{u, v} (Source.ofMeasurable source))
    (selects : Space.Selects source keys codomain) :
    Hom.comp (Space.exponentialToPi source keys codomain)
        (Space.piToExponential source keys codomain selects) =
      Hom.identity (pi fun _ : ι => codomain) := by
  apply Hom.ext
  intro values
  rfl

theorem Space.piToExponential_exponentialToPi (source : Problib.Measure.Space Ω)
    (keys : Problib.Measure.Space ι)
    (codomain : Space.{u, v} (Source.ofMeasurable source))
    (selects : Space.Selects source keys codomain) :
    Hom.comp (Space.piToExponential source keys codomain selects)
        (Space.exponentialToPi source keys codomain) =
      Hom.identity
        (exponential (Space.ofMeasurable source keys) codomain) := by
  apply Hom.ext
  intro morphism
  apply Hom.ext
  intro point
  rfl

/-- Canonical quasi-Borel morphism from the exponential out of a space of keys
into a generated space to the space generated by the measurable product. -/
@[expose] def Space.exponentialToMeasurable (source : Problib.Measure.Space Ω)
    (keys : Problib.Measure.Space ι)
    (target : Problib.Measure.Space β) :
    Hom (exponential (Space.ofMeasurable source keys)
        (Space.ofMeasurable source target))
      (Space.ofMeasurable source (Problib.Measure.Space.pi fun _ : ι => target)) :=
  Hom.comp (Space.piToMeasurable source fun _ : ι => target)
    (Space.exponentialToPi source keys (Space.ofMeasurable source target))

/-- Canonical quasi-Borel morphism from the space generated by the measurable
product over countable keys with measurable points to the exponential out of
the space of keys. -/
@[expose] def Space.exponentialOfMeasurable (source : Problib.Measure.Space Ω)
    (keys : Problib.Measure.Space ι) (countable : ∃ code : ι → Nat, Function.Injective code)
    (points : ∀ point, keys.Measurable (Problib.Measure.Set.singleton point))
    (target : Problib.Measure.Space β) :
    Hom (Space.ofMeasurable source (Problib.Measure.Space.pi fun _ : ι => target))
      (exponential (Space.ofMeasurable source keys)
        (Space.ofMeasurable source target)) :=
  Hom.comp
    (Space.piToExponential source keys (Space.ofMeasurable source target)
      (Space.selects_ofMeasurable countable points target))
    (Space.piOfMeasurable source fun _ : ι => target)

theorem Space.exponentialToMeasurable_exponentialOfMeasurable (source : Problib.Measure.Space Ω)
    (keys : Problib.Measure.Space ι) (countable : ∃ code : ι → Nat, Function.Injective code)
    (points : ∀ point, keys.Measurable (Problib.Measure.Set.singleton point))
    (target : Problib.Measure.Space β) :
    Hom.comp (Space.exponentialToMeasurable source keys target)
        (Space.exponentialOfMeasurable source keys countable points target) =
      Hom.identity (Space.ofMeasurable source (Problib.Measure.Space.pi fun _ : ι => target)) := by
  apply Hom.ext
  intro values
  rfl

theorem Space.exponentialOfMeasurable_exponentialToMeasurable (source : Problib.Measure.Space Ω)
    (keys : Problib.Measure.Space ι) (countable : ∃ code : ι → Nat, Function.Injective code)
    (points : ∀ point, keys.Measurable (Problib.Measure.Set.singleton point))
    (target : Problib.Measure.Space β) :
    Hom.comp (Space.exponentialOfMeasurable source keys countable points target)
        (Space.exponentialToMeasurable source keys target) =
      Hom.identity (exponential (Space.ofMeasurable source keys)
        (Space.ofMeasurable source target)) := by
  apply Hom.ext
  intro morphism
  apply Hom.ext
  intro point
  rfl

end

end Problib.QuasiBorel
