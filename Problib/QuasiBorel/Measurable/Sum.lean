module

public import Problib.QuasiBorel.Sum
public import Problib.QuasiBorel.Measurable.Induced
public import Problib.Measure.Embedding.Sum

set_option autoImplicit false

/-!
# Induced measurable space of quasi-Borel sums

This module proves that the induced measurable functor preserves binary sums.
For every measurable random source, $L(A + B) = L(A) + L(B)$.
Summand injections also yield measurable embedding certificates.
The generating functor preserves binary sums as well: the sum of generated
quasi-Borel spaces is isomorphic to the space generated by the measurable sum.
-/
namespace Problib.QuasiBorel

public section

universe u v w

variable {Ω : Type u} {source : Problib.Measure.Space Ω}
  {left : Space.{u, v} (Source.ofMeasurable source)}
  {right : Space.{u, w} (Source.ofMeasurable source)}

/-- Proves that every accepted sum random element is measurable into
the direct sum of the induced measurable spaces. -/
theorem SumRandom.measurable {random : Ω → _root_.Sum left.Carrier right.Carrier}
    (accepted : SumRandom left right random) :
    Problib.Measure.MeasurableMap source
      (Problib.Measure.Space.sum left.toMeasurable right.toMeasurable) random := by
  induction accepted with
  | inl accepted =>
      exact Problib.Measure.MeasurableMap.comp
        (Problib.Measure.MeasurableMap.inl _ _) (Space.random_measurable accepted)
  | inr accepted =>
      exact Problib.Measure.MeasurableMap.comp
        (Problib.Measure.MeasurableMap.inr _ _) (Space.random_measurable accepted)
  | reparam measurable _ induction =>
      exact Problib.Measure.MeasurableMap.comp induction measurable
  | piecewise measurable _ induction =>
      exact Problib.Measure.MeasurableMap.countable_piecewise measurable induction

/-- Proves that the induced measurable space of a quasi-Borel sum is the direct
sum of the induced measurable spaces of its summands. -/
theorem Space.toMeasurable_sum
    (left : Space.{u, v} (Source.ofMeasurable source))
    (right : Space.{u, w} (Source.ofMeasurable source)) :
    (sum left right).toMeasurable =
      Problib.Measure.Space.sum left.toMeasurable right.toMeasurable := by
  apply Problib.Measure.Space.ext
  intro region
  constructor
  · intro measurable
    exact ⟨fun accepted => measurable (SumRandom.inl accepted),
      fun accepted => measurable (SumRandom.inr accepted)⟩
  · intro measurable random accepted
    exact accepted.measurable measurable

/-- Canonical left injection as a measurable embedding into the induced sum space. -/
@[expose] def Space.inlEmbedding
    (left : Space.{u, v} (Source.ofMeasurable source))
    (right : Space.{u, w} (Source.ofMeasurable source)) :
    Problib.Measure.MeasurableEmbedding left.toMeasurable (sum left right).toMeasurable where
  function := _root_.Sum.inl
  injective := fun _ _ equal => _root_.Sum.inl.inj equal
  measurable := (inl left right).toMeasurable
  image_measurable := by
    rw [toMeasurable_sum]
    exact (Problib.Measure.MeasurableEmbedding.inl _ _).image_measurable

/-- Canonical right injection as a measurable embedding into the induced sum space. -/
@[expose] def Space.inrEmbedding
    (left : Space.{u, v} (Source.ofMeasurable source))
    (right : Space.{u, w} (Source.ofMeasurable source)) :
    Problib.Measure.MeasurableEmbedding right.toMeasurable (sum left right).toMeasurable where
  function := _root_.Sum.inr
  injective := fun _ _ equal => _root_.Sum.inr.inj equal
  measurable := (inr left right).toMeasurable
  image_measurable := by
    rw [toMeasurable_sum]
    exact (Problib.Measure.MeasurableEmbedding.inr _ _).image_measurable

@[simp] theorem Space.inlEmbedding_apply
    (left : Space.{u, v} (Source.ofMeasurable source))
    (right : Space.{u, w} (Source.ofMeasurable source)) (value : left.Carrier) :
    (inlEmbedding left right).function value = _root_.Sum.inl value := rfl

@[simp] theorem Space.inrEmbedding_apply
    (left : Space.{u, v} (Source.ofMeasurable source))
    (right : Space.{u, w} (Source.ofMeasurable source)) (value : right.Carrier) :
    (inrEmbedding left right).function value = _root_.Sum.inr value := rfl

variable {α : Type v} {β : Type w}

/-- A map out of an empty type is measurable. -/
private theorem measurable_of_empty {domain : Problib.Measure.Space α}
    {codomain : Problib.Measure.Space β} {function : α → β} (empty : ¬Nonempty α) :
    Problib.Measure.MeasurableMap domain codomain function := by
  intro region _
  have equal : Problib.Measure.Set.preimage function region = Problib.Measure.Set.empty := by
    apply Problib.Measure.Set.ext
    intro value
    exact (empty ⟨value⟩).elim
  rw [equal]
  exact domain.empty

/-- Proves that every accepted random element of a sum of generated spaces is
measurable into the measurable sum. -/
theorem SumRandom.measurable_ofMeasurable {source : Problib.Measure.Space Ω}
    {left : Problib.Measure.Space α} {right : Problib.Measure.Space β}
    {random : Ω → _root_.Sum (Space.ofMeasurable source left).Carrier
      (Space.ofMeasurable source right).Carrier}
    (accepted : SumRandom (Space.ofMeasurable source left) (Space.ofMeasurable source right)
      random) :
    Problib.Measure.MeasurableMap source (Problib.Measure.Space.sum left right) random := by
  induction accepted with
  | inl accepted =>
      exact Problib.Measure.MeasurableMap.comp (Problib.Measure.MeasurableMap.inl _ _) accepted
  | inr accepted =>
      exact Problib.Measure.MeasurableMap.comp (Problib.Measure.MeasurableMap.inr _ _) accepted
  | reparam measurable _ induction =>
      exact Problib.Measure.MeasurableMap.comp induction measurable
  | piecewise measurable _ induction =>
      exact Problib.Measure.MeasurableMap.countable_piecewise measurable induction

/-- Summand tag of a sum value: `0` on the left and `1` on the right. -/
private def sumTag : _root_.Sum α β → Nat :=
  _root_.Sum.elim (fun _ => 0) (fun _ => 1)

/-- Branch `0` keeps left values and branch `n + 1` keeps right values. The
other summand is replaced by a fallback point. -/
private def sumBranch (leftPoint : α) (rightPoint : β) : Nat → _root_.Sum α β → _root_.Sum α β
  | 0, value => _root_.Sum.inl (_root_.Sum.elim (fun point => point) (fun _ => leftPoint) value)
  | _ + 1, value => _root_.Sum.inr (_root_.Sum.elim (fun _ => rightPoint) (fun point => point) value)

private theorem sumBranch_sumTag (leftPoint : α) (rightPoint : β) (value : _root_.Sum α β) :
    sumBranch leftPoint rightPoint (sumTag value) value = value := by
  cases value <;> rfl

/-- Proves that every measurable map into the measurable sum is an accepted random
element of the sum of generated spaces. A summand with no points needs no branch. -/
theorem SumRandom.of_measurable {source : Problib.Measure.Space Ω}
    {left : Problib.Measure.Space α} {right : Problib.Measure.Space β}
    {random : Ω → _root_.Sum α β}
    (measurable : Problib.Measure.MeasurableMap source (Problib.Measure.Space.sum left right)
      random) :
    SumRandom (Space.ofMeasurable source left) (Space.ofMeasurable source right) random := by
  classical
  by_cases leftInhabited : Nonempty α
  · by_cases rightInhabited : Nonempty β
    · rcases leftInhabited with ⟨leftPoint⟩
      rcases rightInhabited with ⟨rightPoint⟩
      have equal : random = fun seed =>
          sumBranch leftPoint rightPoint (sumTag (random seed)) (random seed) :=
        funext fun seed => (sumBranch_sumTag leftPoint rightPoint (random seed)).symm
      have tagMeasurable : Problib.Measure.MeasurableMap (Problib.Measure.Space.sum left right)
          (Problib.Measure.Space.discrete Nat) (sumTag (α := α) (β := β)) :=
        Problib.Measure.MeasurableMap.sum_elim
          (Problib.Measure.MeasurableMap.constant _ _ 0)
          (Problib.Measure.MeasurableMap.constant _ _ 1)
      have glued : SumRandom (Space.ofMeasurable source left) (Space.ofMeasurable source right)
          (fun seed => sumBranch leftPoint rightPoint (sumTag (random seed)) (random seed)) := by
        refine SumRandom.piecewise (left := Space.ofMeasurable source left)
          (right := Space.ofMeasurable source right) (partition := fun seed => sumTag (random seed))
          (branches := fun index seed => sumBranch leftPoint rightPoint index (random seed)) ?_ ?_
        · intro index
          exact measurable (tagMeasurable
            (Problib.Measure.Space.discrete_measurable (fun number => number = index)))
        · intro index
          cases index with
          | zero =>
              exact SumRandom.inl (Problib.Measure.MeasurableMap.comp
                (Problib.Measure.MeasurableMap.sum_elim
                  (Problib.Measure.MeasurableMap.identity left)
                  (Problib.Measure.MeasurableMap.constant _ _ leftPoint)) measurable)
          | succ index =>
              exact SumRandom.inr (Problib.Measure.MeasurableMap.comp
                (Problib.Measure.MeasurableMap.sum_elim
                  (Problib.Measure.MeasurableMap.constant _ _ rightPoint)
                  (Problib.Measure.MeasurableMap.identity right)) measurable)
      rw [equal]
      exact glued
    · have equal : random = fun seed => _root_.Sum.inl
          (_root_.Sum.elim (fun point => point) (fun point => (rightInhabited ⟨point⟩).elim)
            (random seed)) := by
        funext seed
        cases random seed with
        | inl _ => rfl
        | inr point => exact (rightInhabited ⟨point⟩).elim
      rw [equal]
      exact SumRandom.inl (Problib.Measure.MeasurableMap.comp
        (Problib.Measure.MeasurableMap.sum_elim (Problib.Measure.MeasurableMap.identity left)
          (measurable_of_empty rightInhabited)) measurable)
  · have equal : random = fun seed => _root_.Sum.inr
        (_root_.Sum.elim (fun point => (leftInhabited ⟨point⟩).elim) (fun point => point)
          (random seed)) := by
      funext seed
      cases random seed with
      | inl point => exact (leftInhabited ⟨point⟩).elim
      | inr _ => rfl
    rw [equal]
    exact SumRandom.inr (Problib.Measure.MeasurableMap.comp
      (Problib.Measure.MeasurableMap.sum_elim (measurable_of_empty leftInhabited)
        (Problib.Measure.MeasurableMap.identity right)) measurable)

/-- Canonical quasi-Borel morphism from the sum of generated quasi-Borel spaces
to the space generated by the measurable sum. -/
@[expose] def Space.sumToMeasurable (source : Problib.Measure.Space Ω)
    (left : Problib.Measure.Space α) (right : Problib.Measure.Space β) :
    Hom (sum (Space.ofMeasurable source left) (Space.ofMeasurable source right))
      (Space.ofMeasurable source (Problib.Measure.Space.sum left right)) where
  toFun := fun value => value
  map_random := fun accepted => accepted.measurable_ofMeasurable

/-- Canonical quasi-Borel morphism from the space generated by the measurable sum
to the sum of generated quasi-Borel spaces. -/
@[expose] def Space.sumOfMeasurable (source : Problib.Measure.Space Ω)
    (left : Problib.Measure.Space α) (right : Problib.Measure.Space β) :
    Hom (Space.ofMeasurable source (Problib.Measure.Space.sum left right))
      (sum (Space.ofMeasurable source left) (Space.ofMeasurable source right)) where
  toFun := fun value => value
  map_random := fun measurable => SumRandom.of_measurable measurable

theorem Space.sumToMeasurable_sumOfMeasurable (source : Problib.Measure.Space Ω)
    (left : Problib.Measure.Space α) (right : Problib.Measure.Space β) :
    Hom.comp (Space.sumToMeasurable source left right) (Space.sumOfMeasurable source left right) =
      Hom.identity (Space.ofMeasurable source (Problib.Measure.Space.sum left right)) := by
  apply Hom.ext
  intro value
  rfl

theorem Space.sumOfMeasurable_sumToMeasurable (source : Problib.Measure.Space Ω)
    (left : Problib.Measure.Space α) (right : Problib.Measure.Space β) :
    Hom.comp (Space.sumOfMeasurable source left right) (Space.sumToMeasurable source left right) =
      Hom.identity (sum (Space.ofMeasurable source left) (Space.ofMeasurable source right)) := by
  apply Hom.ext
  intro value
  rfl

end

end Problib.QuasiBorel
