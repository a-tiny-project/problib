module

public import Problib.QuasiBorel.Tree
public import Problib.QuasiBorel.Measurable.Basic
public import Problib.Measure.Space.Tree

set_option autoImplicit false

/-!
# Generated quasi-Borel trees

For a nonempty measurable random source, the quasi-Borel trees over generated
fields are the space generated by the measurable tree space. A measurable random
tree splits by its rank into pieces of one shape, and a random tree of one shape
is built node by node from its measurable root slices.
-/

namespace Problib.QuasiBorel

open Problib.Measure (MeasurableMap)

public section

universe u v

variable {Ω : Type u} {signature : Signature} {Field : Fin signature.count → Type v}

/-- Every accepted random tree over generated fields is measurable. -/
theorem TreeRandom.measurable_ofMeasurable {source : Problib.Measure.Space Ω}
    {fields : ∀ label, Problib.Measure.Space (Field label)}
    {random : Ω → Tree signature fun label => (Space.ofMeasurable source (fields label)).Carrier}
    (accepted : TreeRandom (fun label => Space.ofMeasurable source (fields label)) random) :
    MeasurableMap source (Problib.Measure.Space.tree fields) random := by
  induction accepted with
  | node label field _ induction =>
      exact MeasurableMap.comp (Problib.Measure.TreeSpace.roll_measurable fields)
        (MeasurableMap.comp (MeasurableMap.sigma_mk _ label)
          (Problib.Measure.Space.pair_measurable field (Problib.Measure.Space.pi_measurable induction)))
  | reparam measurable _ induction => exact MeasurableMap.comp induction measurable
  | piecewise measurable _ induction => exact MeasurableMap.countable_piecewise measurable induction

/-- A measurable random tree whose values share one shape is accepted. -/
private theorem TreeRandom.of_shaped {source : Problib.Measure.Space Ω}
    {fields : ∀ label, Problib.Measure.Space (Field label)} (start : Ω) (form : Tree.Shape signature) :
    ∀ {random : Ω → Tree signature Field},
      MeasurableMap source (Problib.Measure.Space.tree fields) random →
      (∀ seed, Tree.shape (random seed) = form) →
      TreeRandom (fun label => Space.ofMeasurable source (fields label)) random := by
  induction form with
  | node label _ children induction =>
      intro random measurable shaped
      have labelled : ∀ seed, (Tree.unroll (random seed)).1 = label := by
        intro seed
        have same := shaped seed
        generalize random seed = tree at same ⊢
        cases tree
        exact (Tree.node.inj same).1
      let payload := fun seed =>
        Problib.Measure.sigmaSlice label (labelled start ▸ (Tree.unroll (random start)).2) (Tree.unroll (random seed))
      have payloadMeasurable : MeasurableMap source _ payload :=
        MeasurableMap.comp (MeasurableMap.sigma_slice _ label _)
          (MeasurableMap.comp (Problib.Measure.TreeSpace.unroll_measurable fields) measurable)
      have equal : random = fun seed => Tree.node label (payload seed).1 fun index => (payload seed).2 index := by
        funext seed
        rw [← Tree.roll_unroll (random seed), Problib.Measure.sigmaSlice_eq _ (labelled seed)]
        rfl
      have childShaped : ∀ index seed, Tree.shape ((payload seed).2 index) = children index := by
        intro index seed
        have same := shaped seed
        rw [equal] at same
        exact congrFun (eq_of_heq (Tree.node.inj same).2.2) index
      rw [equal]
      exact .node label (MeasurableMap.comp (Problib.Measure.Space.first_measurable _ _) payloadMeasurable)
        fun index => induction index (MeasurableMap.comp (Problib.Measure.Space.coordinate_measurable _ index)
          (MeasurableMap.comp (Problib.Measure.Space.second_measurable _ _) payloadMeasurable))
          (childShaped index)

/-- Every measurable random tree is accepted when the source has a point. With
no point and no leaf constructor there is no tree, and no rule accepts the empty
map. -/
theorem TreeRandom.of_measurable {source : Problib.Measure.Space Ω}
    {fields : ∀ label, Problib.Measure.Space (Field label)} (inhabited : Nonempty Ω)
    {random : Ω → Tree signature Field}
    (measurable : MeasurableMap source (Problib.Measure.Space.tree fields) random) :
    TreeRandom (fun label => Space.ofMeasurable source (fields label)) random := by
  classical
  obtain ⟨start⟩ := inhabited
  have ranked : ∀ rank, source.Measurable fun seed => Tree.rank (random seed) = rank := fun rank =>
    MeasurableMap.comp (Problib.Measure.TreeSpace.rank_measurable fields) measurable
      (Problib.Measure.Space.discrete_measurable fun found => found = rank)
  let witness := fun rank => if found : ∃ seed, Tree.rank (random seed) = rank then Classical.choose found else start
  let branches := fun rank seed => if Tree.rank (random seed) = rank then random seed else random (witness rank)
  have glued : TreeRandom (fun label => Space.ofMeasurable source (fields label))
      (fun seed => branches (Tree.rank (random seed)) seed) := by
    refine .piecewise (partition := fun seed => Tree.rank (random seed)) ranked fun rank => ?_
    apply TreeRandom.of_shaped start (Tree.shape (random (witness rank)))
    · have equal : branches rank = fun seed => (fun choice : Nat => if choice = 0 then random seed
          else random (witness rank)) (if Tree.rank (random seed) = rank then 0 else 1) := by
        funext seed
        by_cases same : Tree.rank (random seed) = rank <;> simp [branches, same]
      have pieces : ∀ choice : Nat, MeasurableMap source (Problib.Measure.Space.tree fields)
          fun seed => if choice = 0 then random seed else random (witness rank) := by
        intro choice
        by_cases zero : choice = 0
        · simp only [zero, ↓reduceIte]
          exact measurable
        · simp only [zero, ↓reduceIte]
          exact MeasurableMap.constant source (Problib.Measure.Space.tree fields) _
      rw [equal]
      intro region regionMeasurable
      exact MeasurableMap.countable_piecewise (fun choice =>
        MeasurableMap.comp (Problib.Measure.TreeSpace.rank_measurable fields) measurable
          (set := fun found => (if found = rank then 0 else 1) = choice) trivial) pieces regionMeasurable
    · intro seed
      by_cases same : Tree.rank (random seed) = rank
      · simp only [branches, same, ↓reduceIte]
        have found : ∃ seed, Tree.rank (random seed) = rank := ⟨seed, same⟩
        have chosen : Tree.rank (random (witness rank)) = rank := by
          simp only [witness, found, dite_true]
          exact Classical.choose_spec found
        exact Tree.code_injective (fun _ _ _ _ => rfl) (same.trans chosen.symm)
      · simp [branches, same]
  have equal : (fun seed => branches (Tree.rank (random seed)) seed) = random := by
    funext seed
    simp [branches]
  rwa [equal] at glued

/-- The quasi-Borel trees over generated fields map into the generated
measurable trees. -/
@[expose] def Space.treeToMeasurable (source : Problib.Measure.Space Ω)
    (fields : ∀ label, Problib.Measure.Space (Field label)) :
    Hom (Space.tree fun label => Space.ofMeasurable source (fields label))
      (Space.ofMeasurable source (Problib.Measure.Space.tree fields)) where
  toFun := fun tree => tree
  map_random := fun accepted => accepted.measurable_ofMeasurable

/-- Over a nonempty source, the generated measurable trees map back. -/
@[expose] def Space.treeOfMeasurable (source : Problib.Measure.Space Ω)
    (fields : ∀ label, Problib.Measure.Space (Field label)) (inhabited : Nonempty Ω) :
    Hom (Space.ofMeasurable source (Problib.Measure.Space.tree fields))
      (Space.tree fun label => Space.ofMeasurable source (fields label)) where
  toFun := fun tree => tree
  map_random := fun measurable => TreeRandom.of_measurable inhabited measurable

theorem Space.treeToMeasurable_treeOfMeasurable (source : Problib.Measure.Space Ω)
    (fields : ∀ label, Problib.Measure.Space (Field label)) (inhabited : Nonempty Ω) :
    Hom.comp (Space.treeToMeasurable source fields) (Space.treeOfMeasurable source fields inhabited) =
      Hom.identity _ :=
  Hom.ext fun _ => rfl

theorem Space.treeOfMeasurable_treeToMeasurable (source : Problib.Measure.Space Ω)
    (fields : ∀ label, Problib.Measure.Space (Field label)) (inhabited : Nonempty Ω) :
    Hom.comp (Space.treeOfMeasurable source fields inhabited) (Space.treeToMeasurable source fields) =
      Hom.identity _ :=
  Hom.ext fun _ => rfl

end

end Problib.QuasiBorel
