import Problib.QuasiBorel.Pi
import Problib.QuasiBorel.Measurable.Hom
import Problib.QuasiBorel.SFinite.Weight
import Problib.QuasiBorel.SFinite.Counting
import Problib.QuasiBorel.SFinite.Probability.Monad
import Problib.QuasiBorel.SFinite.Probability.Normalized
import Problib.Inference.Population
import Problib.Measure.Integral.Lebesgue.Extensionality

/-!
# Counted proper weighting of quasi-Borel population laws

A population of `n` lanes is a tuple of `n` values in a quasi-Borel space `Y`,
each with a finite nonnegative weight. A sampler is a probability law on
populations, and its lanes may depend on each other in any way. The sampler is
properly weighted for an s-finite target `μ` on `Y` when its expected empirical
measure, the average of the lanes' weighted Dirac laws, is `μ`
(`ProperlyWeightedLaw`). Read on tests, this is
`E[(1/n) Σ_i w_i f(y_i)] = ∫ f dμ` for every quasi-Borel morphism `f` from `Y`
to `[0, ∞]` (`properlyWeightedLaw_iff_lintegral`). Neither the target's mass nor
any second moment is assumed finite, and the test `f = 1` makes the expected
mean weight the target's mass (`properlyWeightedLaw_mass`). The count is
positive by type, so an empty population is never a sampler.

At count one a population is a weighted pair (`singletonPopulation`), and the
contract reads as the reweighted pair law being the target
(`properlyWeightedLaw_one_iff`). Picking one lane uniformly from a population
gives a weighted pair whose law has the population's barycenter
(`empiricalBarycenter_eq_pick`). The pick keeps the first moment only: the
picked pair's weight can have a different second moment from the population's
mean weight, so a variance statement about a population says nothing about its
picked lane, and conversely.

The lane average is the first-order one (`Problib.Inference.Lanes.fin`), so the
equation above is the integrand of `Problib.Inference.lintegral_empirical`.
-/

set_option autoImplicit false

namespace Problib.QuasiBorel.SFinite

open Problib.Measure hiding Space
open Problib.Measure.Real (borel)
open Problib.Real (ENNReal NNReal)

universe u

/-! ### Lanes and populations -/

/-- Finite nonnegative weights, as a quasi-Borel space generated by the
measurable space of weights that first-order proper weighting uses. -/
abbrev finiteWeightSpace : Space realSource :=
  Space.ofMeasurable borel Problib.Inference.weightSpace

/-- A finite weight read as an extended weight. -/
noncomputable def finiteWeight : Hom finiteWeightSpace weightSpace :=
  Hom.ofMeasurable (Problib.Measure.Space.comap_map ENNReal.finite ennrealBorel)

@[simp] theorem finiteWeight_apply (weight : NNReal) : finiteWeight weight = ENNReal.finite weight :=
  rfl

/-- One lane: a value with its finite weight. -/
abbrev Lane (space : Space.{0, u} realSource) : Space.{0, u} realSource :=
  Space.product space finiteWeightSpace

/-- A population of `count` lanes, with any joint law. -/
abbrev Population (space : Space.{0, u} realSource) (count : Nat) : Space.{0, u} realSource :=
  Space.pi (fun _ : Fin count => Lane space)

/-- The `lane`-th coordinate of a population. -/
abbrev laneAt (space : Space.{0, u} realSource) {count : Nat} (lane : Fin count) :
    Hom (Population space count) (Lane space) :=
  Space.project (fun _ : Fin count => Lane space) lane

/-- The lanes `0, …, count - 1` of a positive count, with share `1 / count`. -/
def lanes (count : Nat) (positive : 0 < count) : Problib.Inference.Lanes (Fin count) :=
  @Problib.Inference.Lanes.fin count ⟨Nat.pos_iff_ne_zero.mp positive⟩

/-- A lane's weighted Dirac law `w δ_y`. -/
noncomputable def weightedLane (space : Space.{0, u} realSource) : Hom (Lane space) (object space) :=
  Hom.comp (weightedPoint space)
    (Space.pair (Hom.comp finiteWeight (Space.second space finiteWeightSpace))
      (Space.first space finiteWeightSpace))

theorem lintegral_weightedLane {space : Space.{0, u} realSource} (test : Hom space weightSpace)
    (lane : (Lane space).Carrier) :
    lintegral (weightedLane space lane).val test =
      ENNReal.mul (ENNReal.finite lane.2) (test lane.1) := by
  change lintegral (weightedPoint space (ENNReal.finite lane.2, lane.1)).val test = _
  rw [weightedPoint_val, lintegral_smul_measure, lintegral_dirac _ _ (weight_measurable test)]

/-! ### Averages over lanes -/

/-- The terms a lane average sums: the given law at each lane, and the zero law
past the last lane. -/
noncomputable def laneTerms {domain : Space.{0, u} realSource} {target : Space.{0, u} realSource}
    {count : Nat} (kernels : Fin count → Hom domain (object target)) (index : Nat) :
    Hom domain (object target) :=
  if lane : index < count then kernels ⟨index, lane⟩
  else Hom.constant domain (object target) (zero target)

/-- The average `(1 / count) Σ_lane kernels lane` of law-valued morphisms. -/
noncomputable def laneAverage {domain : Space.{0, u} realSource} {target : Space.{0, u} realSource}
    (count : Nat) (positive : 0 < count) (kernels : Fin count → Hom domain (object target)) :
    Hom domain (object target) :=
  Hom.comp (scale target)
    (Space.pair (Hom.constant domain weightSpace (ENNReal.finite (lanes count positive).share))
      (sum (laneTerms kernels)))

/-- A series that stops after `count` terms sums the listed terms. -/
private theorem tsum_lanes : ∀ (count : Nat) (values : Fin count → ENNReal),
    ENNReal.tsum (fun index => if lane : index < count then values ⟨index, lane⟩ else ENNReal.zero) =
      ENNReal.additiveLaws.listSum ((List.finRange count).map values)
  | 0, values => by
      rw [List.finRange_zero, List.map_nil,
        ENNReal.tsum_congr (right := fun _ => ENNReal.zero) (fun index => dite_eq_right (Nat.not_lt_zero index))]
      exact ENNReal.tsum_zero
  | count + 1, values => by
      have head : ENNReal.partialSum
          (fun index => if lane : index < count + 1 then values ⟨index, lane⟩ else ENNReal.zero) 1 =
            values 0 := by
        change ENNReal.add ENNReal.zero (if lane : 0 < count + 1 then values ⟨0, lane⟩ else ENNReal.zero) = _
        rw [ENNReal.zero_add, dite_eq_left (Nat.succ_pos count)]
        rfl
      have tail : ∀ index,
          (if lane : 1 + index < count + 1 then values ⟨1 + index, lane⟩ else ENNReal.zero) =
            (if lane : index < count then values (Fin.succ ⟨index, lane⟩) else ENNReal.zero) := by
        intro index
        by_cases lane : index < count
        · rw [dite_eq_left (by omega), dite_eq_left lane]
          exact congrArg values (Fin.ext (Nat.add_comm 1 index))
        · rw [dite_eq_right (by omega), dite_eq_right lane]
      rw [← ENNReal.partialSum_add_tail _ 1, head, ENNReal.tsum_congr tail,
        tsum_lanes count (fun lane => values lane.succ), List.finRange_succ, List.map_cons, List.map_map]
      rfl

/-- Integrating against a lane average averages the lanes' integrals. -/
theorem lintegral_laneAverage {domain : Space.{0, u} realSource} {target : Space.{0, u} realSource}
    {count : Nat} (positive : 0 < count) (kernels : Fin count → Hom domain (object target))
    (point : domain.Carrier) (function : target.Carrier → ENNReal) :
    lintegral (laneAverage count positive kernels point).val function =
      ENNReal.mul (ENNReal.finite (lanes count positive).share)
        (ENNReal.additiveLaws.listSum ((List.finRange count).map fun lane =>
          lintegral (kernels lane point).val function)) := by
  change lintegral (scale target (ENNReal.finite (lanes count positive).share,
    sum (laneTerms kernels) point)).val function = _
  rw [scale_val, lintegral_smul_measure, sum_apply, Law.sum_val, lintegral_sum,
    ← tsum_lanes count (fun lane => lintegral (kernels lane point).val function)]
  apply congrArg (ENNReal.mul _)
  apply ENNReal.tsum_congr
  intro index
  unfold laneTerms
  by_cases lane : index < count
  · rw [dite_eq_left lane, dite_eq_left lane]
  · rw [dite_eq_right lane, dite_eq_right lane]
    exact lintegral_zero_measure function

/-! ### The empirical barycenter -/

/-- The empirical measure of a population, `(1 / count) Σ_i w_i δ_{y_i}`. -/
noncomputable def empirical (space : Space.{0, u} realSource) (count : Nat) (positive : 0 < count) :
    Hom (Population space count) (object space) :=
  laneAverage count positive (fun lane => Hom.comp (weightedLane space) (laneAt space lane))

/-- The empirical measure integrates a test to the lanes' weighted average. -/
theorem lintegral_empirical {space : Space.{0, u} realSource} {count : Nat} (positive : 0 < count)
    (test : Hom space weightSpace) (population : (Population space count).Carrier) :
    lintegral (empirical space count positive population).val test =
      ENNReal.mul (ENNReal.finite (lanes count positive).share)
        (ENNReal.additiveLaws.listSum ((List.finRange count).map fun lane =>
          ENNReal.mul (ENNReal.finite (population lane).2) (test (population lane).1))) := by
  rw [empirical, lintegral_laneAverage]
  simp only [Hom.comp_apply]
  simp only [lintegral_weightedLane]
  rfl

/-- The expected empirical measure of a population sampler. -/
noncomputable def empiricalBarycenter {space : Space.{0, u} realSource} (count : Nat) (positive : 0 < count)
    (sampler : Probability.Law (Population space count)) : Law space :=
  bind (ofProbability sampler) (empirical space count positive)

theorem lintegral_empiricalBarycenter {space : Space.{0, u} realSource} {count : Nat} (positive : 0 < count)
    (sampler : Probability.Law (Population space count)) (test : Hom space weightSpace) :
    lintegral (empiricalBarycenter count positive sampler).val test =
      lintegral sampler.val.val (fun population =>
        ENNReal.mul (ENNReal.finite (lanes count positive).share)
          (ENNReal.additiveLaws.listSum ((List.finRange count).map fun lane =>
            ENNReal.mul (ENNReal.finite (population lane).2) (test (population lane).1)))) := by
  rw [empiricalBarycenter, bind_val, Measure.lintegral_bind _ _ (weight_measurable test), ofProbability_val]
  apply lintegral_congr
  intro population
  exact lintegral_empirical positive test population

/-! ### The contract -/

/-- A sampler of `count` weighted lanes is properly weighted for `target`: its
expected empirical measure is `target`. -/
def ProperlyWeightedLaw {space : Space.{0, u} realSource} (count : Nat) (positive : 0 < count)
    (target : Law space) (sampler : Probability.Law (Population space count)) : Prop :=
  empiricalBarycenter count positive sampler = target

/-- A measurable test into `[0, ∞]`, as a quasi-Borel morphism. -/
def measurableTest {space : Space.{0, u} realSource} {function : space.Carrier → ENNReal}
    (measurable : ENNRealMeasurable space.toMeasurable function) : Hom space weightSpace where
  toFun := function
  map_random := fun accepted => Space.measurableMap_iff_random.mp measurable.measurableMap accepted

/-- Proper weighting, read on tests: the expected weighted lane average of every
nonnegative test is its integral against the target. -/
theorem properlyWeightedLaw_iff_lintegral {space : Space.{0, u} realSource} {count : Nat}
    {positive : 0 < count} {target : Law space} {sampler : Probability.Law (Population space count)} :
    ProperlyWeightedLaw count positive target sampler ↔
      ∀ test : Hom space weightSpace,
        lintegral sampler.val.val (fun population =>
          ENNReal.mul (ENNReal.finite (lanes count positive).share)
            (ENNReal.additiveLaws.listSum ((List.finRange count).map fun lane =>
              ENNReal.mul (ENNReal.finite (population lane).2) (test (population lane).1)))) =
          lintegral target.val test := by
  constructor
  · intro proper test
    rw [← lintegral_empiricalBarycenter positive sampler test]
    exact congrArg (fun law : Law space => lintegral law.val test) proper
  · intro tests
    apply Law.ext
    apply (Measure.eq_iff_lintegral _ _).mpr
    intro function measurable
    exact (lintegral_empiricalBarycenter positive sampler (measurableTest measurable)).trans
      (tests (measurableTest measurable))

/-- A properly weighted sampler's expected mean weight is the target's mass. -/
theorem properlyWeightedLaw_mass {space : Space.{0, u} realSource} {count : Nat}
    {positive : 0 < count} {target : Law space} {sampler : Probability.Law (Population space count)}
    (proper : ProperlyWeightedLaw count positive target sampler) :
    lintegral sampler.val.val (fun population =>
      ENNReal.mul (ENNReal.finite (lanes count positive).share)
        (ENNReal.additiveLaws.listSum ((List.finRange count).map fun lane =>
          ENNReal.finite (population lane).2))) =
      mass space target := by
  have tested := properlyWeightedLaw_iff_lintegral.mp proper
    (Hom.constant space weightSpace ENNReal.one)
  simp only [Hom.constant, ENNReal.mul_one] at tested
  rw [tested, lintegral_const, ENNReal.one_mul, mass_apply]

/-- A fixed population is properly weighted for its own empirical measure,
whatever its lanes: nothing asks them to be independent or exchangeable. -/
theorem properlyWeightedLaw_pure {space : Space.{0, u} realSource} {count : Nat} (positive : 0 < count)
    (population : (Population space count).Carrier) :
    ProperlyWeightedLaw count positive (empirical space count positive population)
      (Probability.pure (Population space count) population) := by
  rw [ProperlyWeightedLaw, empiricalBarycenter, ofProbability_pure, pure_bind]

/-! ### Count one -/

/-- A weighted pair as a population of one lane. -/
def singletonPopulation (space : Space.{0, u} realSource) : Hom (Lane space) (Population space 1) :=
  Space.tuple (fun _ => Hom.identity (Lane space))

/-- The one lane of a population of one. -/
def singletonLane (space : Space.{0, u} realSource) : Hom (Population space 1) (Lane space) :=
  laneAt space 0

theorem singletonLane_singletonPopulation (space : Space.{0, u} realSource) :
    Hom.comp (singletonLane space) (singletonPopulation space) = Hom.identity (Lane space) := by
  apply Hom.ext
  intro lane
  rfl

theorem singletonPopulation_singletonLane (space : Space.{0, u} realSource) :
    Hom.comp (singletonPopulation space) (singletonLane space) = Hom.identity (Population space 1) := by
  apply Hom.ext
  intro population
  funext lane
  match lane with
  | ⟨0, _⟩ => rfl

/-- At count one the empirical measure of a pair is its weighted Dirac law. -/
theorem empirical_singletonPopulation (space : Space.{0, u} realSource) :
    Hom.comp (empirical space 1 Nat.one_pos) (singletonPopulation space) = weightedLane space := by
  apply Hom.ext
  intro lane
  apply Law.ext
  apply (Measure.eq_iff_lintegral _ _).mpr
  intro function measurable
  change lintegral (empirical space 1 Nat.one_pos (singletonPopulation space lane)).val (measurableTest measurable) =
    lintegral (weightedLane space lane).val (measurableTest measurable)
  rw [lintegral_empirical, lintegral_weightedLane]
  exact (lanes 1 Nat.one_pos).average_const _

/-- At count one, proper weighting of a pair law is the reweighted pair law
being the target. -/
theorem properlyWeightedLaw_one_iff {space : Space.{0, u} realSource} (target : Law space)
    (pairs : Probability.Law (Lane space)) :
    ProperlyWeightedLaw 1 Nat.one_pos target (Probability.map (singletonPopulation space) pairs) ↔
      bind (ofProbability pairs) (weightedLane space) = target := by
  rw [ProperlyWeightedLaw, empiricalBarycenter, ofProbability_map, bind_map,
    empirical_singletonPopulation]

/-! ### Picking a lane -/

/-- The uniform law over a population's lanes, as an s-finite law. -/
noncomputable def uniformLanes (space : Space.{0, u} realSource) (count : Nat) (positive : 0 < count) :
    Hom (Population space count) (object (Lane space)) :=
  laneAverage count positive (fun lane => Hom.comp (unit (Lane space)) (laneAt space lane))

theorem uniformLanes_probability {space : Space.{0, u} realSource} {count : Nat} (positive : 0 < count)
    (population : (Population space count).Carrier) :
    Measure.IsProbability (uniformLanes space count positive population).val := by
  refine ⟨?_⟩
  have total := lintegral_laneAverage positive
    (fun lane => Hom.comp (unit (Lane space)) (laneAt space lane)) population (fun _ => ENNReal.one)
  rw [lintegral_const, ENNReal.one_mul] at total
  have each : ∀ lane : Fin count,
      lintegral ((Hom.comp (unit (Lane space)) (laneAt space lane)) population).val
        (fun _ => ENNReal.one) = ENNReal.one := by
    intro lane
    rw [lintegral_const, ENNReal.one_mul]
    exact mass_pure (population lane)
  simp only [each] at total
  rw [uniformLanes, total]
  exact (lanes count positive).average_const ENNReal.one

/-- Pick one lane of a population uniformly: the law of one weighted pair. -/
noncomputable def pickLane (space : Space.{0, u} realSource) (count : Nat) (positive : 0 < count) :
    Hom (Population space count) (Probability.object (Lane space)) :=
  Hom.comp (Normalized.toProbabilityHom (Lane space))
    ((uniformLanes space count positive).subtypeLift (fun law => Measure.IsProbability law.val)
      (uniformLanes_probability positive))

theorem ofProbability_pickLane {space : Space.{0, u} realSource} {count : Nat} (positive : 0 < count)
    (population : (Population space count).Carrier) :
    ofProbability (pickLane space count positive population) = uniformLanes space count positive population := by
  apply Law.ext
  rfl

/-- A test on values, read on a weighted lane as `w f(y)`. -/
noncomputable def laneTest {space : Space.{0, u} realSource} (test : Hom space weightSpace) :
    Hom (Lane space) weightSpace :=
  Hom.comp weightMul
    (Space.pair (Hom.comp finiteWeight (Space.second space finiteWeightSpace))
      (Hom.comp test (Space.first space finiteWeightSpace)))

/-- The barycenter of a population law is the count-one barycenter of the law of
one uniformly picked lane. Only the first moment is kept: the picked lane's
weight need not have the second moment of the population's mean weight. -/
theorem empiricalBarycenter_eq_pick {space : Space.{0, u} realSource} {count : Nat} (positive : 0 < count)
    (sampler : Probability.Law (Population space count)) :
    empiricalBarycenter count positive sampler =
      empiricalBarycenter 1 Nat.one_pos
        (Probability.map (singletonPopulation space)
          (Probability.bind sampler (pickLane space count positive))) := by
  rw [empiricalBarycenter, empiricalBarycenter, ofProbability_map, bind_map,
    empirical_singletonPopulation, ofProbability_bind, bind_assoc]
  apply congrArg (bind (ofProbability sampler))
  apply Hom.ext
  intro population
  apply Law.ext
  apply (Measure.eq_iff_lintegral _ _).mpr
  intro function measurable
  let test := measurableTest measurable
  change lintegral (empirical space count positive population).val test =
    lintegral (bind (ofProbability (pickLane space count positive population)) (weightedLane space)).val test
  have integrand : (fun pair => lintegral (toKernel (weightedLane space) pair) test) = laneTest test :=
    funext fun pair => lintegral_weightedLane test pair
  have each : ∀ lane : Fin count,
      lintegral ((Hom.comp (unit (Lane space)) (laneAt space lane)) population).val (laneTest test) =
        ENNReal.mul (ENNReal.finite (population lane).2) (test (population lane).1) := by
    intro lane
    change lintegral (pure (Lane space) (population lane)).val (laneTest test) = _
    rw [pure_val, lintegral_dirac _ _ (weight_measurable (laneTest test))]
    rfl
  rw [lintegral_empirical, ofProbability_pickLane, bind_val,
    Measure.lintegral_bind _ _ (weight_measurable test), integrand, uniformLanes, lintegral_laneAverage]
  simp only [each]

end Problib.QuasiBorel.SFinite
